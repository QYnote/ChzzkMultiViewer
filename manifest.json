{
    "manifest_version": 3,
    "name": "MultiStream",
    "version": "2.2.0",
    "description":"방송 여러개 띄워서 보는 멀티뷰 크롬 확장프로그램",
    "permissions":[
        "storage",
        "tabs",
        "declarativeNetRequest",
        "cookies",
        "scripting"
    ],
    "host_permissions": [
        "https://api.chzzk.naver.com/*",
        "https://chzzk.naver.com/*",
        "https://*.naver.com/*",
        "https://*.sooplive.com/*",
        "https://*.sooplive.co.kr/*",
        "https://myapi.sooplive.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16":  "resources/main_icon_16.png",
        "48":  "resources/main_icon_48.png",
        "128": "resources/main_icon_128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "resources/main_icon_16.png",
            "32": "resources/main_icon_32.png"
        }
    },
    "content_scripts": [
        {
            "matches": ["https://chzzk.naver.com/live/*"],
            "js": ["content.js"],
            "run_at": "document_end",
            "all_frames": true
        },
        {
            "matches": ["https://play.sooplive.com/*"],
            "js": ["content.js"],
            "run_at": "document_end",
            "all_frames": true
        }
    ]
}